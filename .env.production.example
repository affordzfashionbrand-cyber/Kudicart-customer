# ==========================================
# Affordz Customer Mobile Production Environment Variables
# Copy to .env.production before generating release bundle
# ==========================================

EXPO_PUBLIC_APP_ENV=production

# Backend REST API origin (without /api/v1)
EXPO_PUBLIC_API_URL="https://api.affordz.com"

# Firebase Authentication & App Config (public client config)
EXPO_PUBLIC_FIREBASE_API_KEY="[YOUR_FIREBASE_WEB_API_KEY]"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="kudikart-3ec2e.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="kudikart-3ec2e"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="kudikart-3ec2e.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="[YOUR_MESSAGING_SENDER_ID]"
EXPO_PUBLIC_FIREBASE_APP_ID="[YOUR_FIREBASE_APP_ID]"
EXPO_PUBLIC_FIREBASE_VAPID_KEY="[OPTIONAL_WEB_PUSH_VAPID_KEY]"

# Razorpay Client Public Key
EXPO_PUBLIC_RAZORPAY_KEY_ID="rzp_live_[YOUR_LIVE_KEY_ID]"

# Google Maps Platform Key (Restricted to Android package & SHA-1)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSy[YOUR_RESTRICTED_KEY]"

# Sentry Mobile Monitoring
EXPO_PUBLIC_SENTRY_DSN="https://[KEY]@[ORG].ingest.sentry.io/[PROJECT_ID]"
