# ==========================================
# KudiCart Customer Mobile Production Environment Variables
# Copy to .env.production before generating release bundle
# ==========================================

APP_ENV=production

# Backend REST API endpoint URL
EXPO_PUBLIC_API_URL="https://api.affordz.com/api/v1"

# Razorpay Client Public Key
EXPO_PUBLIC_RAZORPAY_KEY_ID="rzp_live_[YOUR_LIVE_KEY_ID]"

# Google Maps Platform Key (Restricted to Android package & SHA-1)
EXPO_PUBLIC_GOOGLE_MAPS_KEY="AIzaSy[YOUR_RESTRICTED_KEY]"

# Sentry Mobile Monitoring
EXPO_PUBLIC_SENTRY_DSN="https://[KEY]@[ORG].ingest.sentry.io/[PROJECT_ID]"
